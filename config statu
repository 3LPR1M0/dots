general {
	output_format = "i3bar"
	colors = false
	markup = pango
	interval = 10
}


order += "load"
order += "disk /"
order += "cpu_usage"
order += "volume master"
order += "time"


load {
	format = "<span background='#d65d0e'>  %5min Load  </span>"
}

disk "/" {
        format = "<span background='#d65d0e'>   %avail  </span>"
}


cpu_usage {
	format = "<span background='#d65d0e'>  %usage CPU_0  </span>"
}

volume master {
	format = "<span background='#d65d0e'>  %volume  </span>"
	format_muted = "<span background='#458588'>  Muted  </span>"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}

time {
	format = "<span background='#458588'>  %b %d at %H:%M   </span>"
}
