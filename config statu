general {
	output_format = "i3bar"
	colors = false
	markup = pango
	interval = 10
}

order += "ipv6"
order += "ethernet _first_"
order += "disk /"
order += "volume master"
order += "time"

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

disk "/" {
        format = "%avail"
}

volume master {
	format = "%volume"
	format_muted = "Muted"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}

time {
	format = "%b %d at %H:%M"
}
